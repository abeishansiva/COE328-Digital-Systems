`timescale 1 ps/ 1 ps
module problem2_vlg_sample_tst(
	A,
	B,
	Clock,
	data_in,
	Enable_Decoder,
	FSM_reset,
	Reset_B,
	Rest_A,
	sampler_tx
);
input [7:0] A;
input [7:0] B;
input  Clock;
input  data_in;
input  Enable_Decoder;
input  FSM_reset;
input  Reset_B;
input  Rest_A;
output sampler_tx;

reg sample;
time current_time;
always @(A or B or Clock or data_in or Enable_Decoder or FSM_reset or Reset_B or Rest_A)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

