	.Reset_B(Reset_B),
	.Rest_A(Rest_A),
	.s_number(s_number),
	.Sign(Sign),
	.student_id(student_id)
);
// A[ 7 ]
initial
begin
	A[7] = 1'b1;
end 
// A[ 6 ]
initial
begin
	A[6] = 1'b0;
end 
// A[ 5 ]
initial
begin
	A[5] = 1'b0;
end 
// A[ 4 ]
initial
begin
	A[4] = 1'b0;
end 
// A[ 3 ]
initial
begin
	A[3] = 1'b0;
end 
// A[ 2 ]
initial
begin
	A[2] = 1'b1;
end 
// A[ 1 ]
initial
begin
	A[1] = 1'b1;
end 
// A[ 0 ]
initial
begin
	A[0] = 1'b0;
end 
// B[ 7 ]
initial
begin
	B[7] = 1'b1;
end 
// B[ 6 ]
initial
begin
	B[6] = 1'b0;
end 
// B[ 5 ]
initial
begin
	B[5] = 1'b0;
end 
// B[ 4 ]
initial
begin
	B[4] = 1'b1;
end 
// B[ 3 ]
initial
begin
	B[3] = 1'b0;
end 
// B[ 2 ]
initial
begin
	B[2] = 1'b1;
end 
// B[ 1 ]
initial
begin
	B[1] = 1'b1;
end 
// B[ 0 ]
initial
begin
	B[0] = 1'b1;
end 

// Clock
initial
begin
	repeat(16)
	begin
		Clock = 1'b0;
		Clock = #30000 1'b1;
		# 30000;
	end
	Clock = 1'b0;
	Clock = #30000 1'b1;
end 

// data_in
initial
begin
	data_in = 1'b1;
end 

// Enable_Decoder
initial
begin
	Enable_Decoder = 1'b1;
end 

// FSM_reset
initial
begin
	FSM_reset = 1'b1;
end 

// Rest_A
initial
begin
	Rest_A = 1'b1;
end 

// Reset_B
initial
begin
	Reset_B = 1'b1;
end 

problem2_vlg_sample_tst tb_sample (
	.A(A),
	.B(B),
	.Clock(Clock),
	.data_in(data_in),
	.Enable_Decoder(Enable_Decoder),
	.FSM_reset(FSM_reset),
	.Reset_B(Reset_B),
	.Rest_A(Rest_A),
	.sampler_tx(sampler)
);

problem2_vlg_check_tst tb_out(
	.DecodetestOut(DecodetestOut),
	.neg_test(neg_test),
	.R1(R1),
	.R2(R2),
	.R_first_four2(R_first_four2),
	.R_last_four(R_last_four),
	.s_number(s_number),
	.Sign(Sign),
	.student_id(student_id),
	.sampler_rx(sampler)
);
