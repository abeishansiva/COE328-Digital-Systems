	.A(A),
	.B(B),
	.Clock(Clock),
	.data_in(data_in),
	.DecodetestOut(DecodetestOut),
	.Enable_Decoder(Enable_Decoder),
	.FSM_reset(FSM_reset),
	.neg_test(neg_test),
	.R1(R1),
	.R2(R2),
