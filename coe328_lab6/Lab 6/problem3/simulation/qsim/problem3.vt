initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module problem3_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [7:0] A;
reg ALU3_reset;
reg [7:0] B;
reg Clock;
reg data_in;
reg Enable_Decoder;
reg FSM_reset;
reg Reset_AB;
// wires                                               
wire [15:0] DecodeTest;
wire [3:0] R1test;
wire [0:6] result;
wire [3:0] student;
wire [0:6] student_id;

wire sampler;                             

// assign statements (if any)                          
problem3 i1 (
// port map - connection between master ports and signals/registers   
	.A(A),
	.ALU3_reset(ALU3_reset),
	.B(B),
	.Clock(Clock),
	.data_in(data_in),
	.DecodeTest(DecodeTest),
	.Enable_Decoder(Enable_Decoder),
	.FSM_reset(FSM_reset),
	.R1test(R1test),
	.Reset_AB(Reset_AB),
	.result(result),
	.student(student),
	.student_id(student_id)
);
// A[ 7 ]
initial
begin
	A[7] = 1'b1;
end 
// A[ 6 ]
initial
begin
	A[6] = 1'b0;
end 
// A[ 5 ]
initial
begin
	A[5] = 1'b0;
end 
// A[ 4 ]
initial
begin
	A[4] = 1'b0;
end 
// A[ 3 ]
initial
begin
	A[3] = 1'b0;
end 
// A[ 2 ]
initial
begin
	A[2] = 1'b1;
end 
// A[ 1 ]
initial
begin
	A[1] = 1'b1;
end 
// A[ 0 ]
initial
begin
	A[0] = 1'b0;
end 
// B[ 7 ]
initial
begin
	B[7] = 1'b1;
end 
// B[ 6 ]
initial
begin
	B[6] = 1'b0;
end 
// B[ 5 ]
initial
begin
	B[5] = 1'b0;
end 
// B[ 4 ]
initial
begin
	B[4] = 1'b1;
end 
// B[ 3 ]
initial
begin
	B[3] = 1'b0;
end 
// B[ 2 ]
initial
begin
	B[2] = 1'b1;
end 
// B[ 1 ]
initial
begin
	B[1] = 1'b1;
end 
// B[ 0 ]
initial
begin
	B[0] = 1'b1;
end 

// Clock
initial
begin
	repeat(16)
	begin
		Clock = 1'b0;
		Clock = #30000 1'b1;
		# 30000;
	end
	Clock = 1'b0;
	Clock = #30000 1'b1;
end 

// data_in
initial
begin
	data_in = 1'b1;
end 

// Enable_Decoder
initial
begin
	Enable_Decoder = 1'b1;
end 

// FSM_reset
initial
begin
	FSM_reset = 1'b1;
end 

// Reset_AB
initial
begin
	Reset_AB = 1'b1;
end 

// ALU3_reset
initial
begin
	ALU3_reset = 1'b1;
end 

problem3_vlg_sample_tst tb_sample (
	.A(A),
	.ALU3_reset(ALU3_reset),
	.B(B),
	.Clock(Clock),
	.data_in(data_in),
	.Enable_Decoder(Enable_Decoder),
	.FSM_reset(FSM_reset),
	.Reset_AB(Reset_AB),
	.sampler_tx(sampler)
);

problem3_vlg_check_tst tb_out(
	.DecodeTest(DecodeTest),
	.R1test(R1test),
	.result(result),
	.student(student),
	.student_id(student_id),
	.sampler_rx(sampler)
);
endmodule

