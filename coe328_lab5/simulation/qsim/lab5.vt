`timescale 1 ps/ 1 ps
module lab5_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg data_in;
reg reset;
// wires                                               
wire [0:6] leds;
wire [0:6] ledss;
wire [0:6] states;
wire [0:6] states_neg;

// assign statements (if any)                          
lab5 i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.data_in(data_in),
	.leds(leds),
	.ledss(ledss),
	.reset(reset),
	.states(states),
	.states_neg(states_neg)
);
initial 
begin 
#1000000 $finish;
end 

// clk
initial
begin
	repeat(16)
	begin
		clk = 1'b0;
		clk = #30000 1'b1;
		# 30000;
	end
	clk = 1'b0;
	clk = #30000 1'b1;
end 

// data_in
initial
begin
	data_in = 1'b1;
end 

// reset
initial
begin
	reset = 1'b0;
end 
initial 
begin 
#1000000 $finish;
end 
endmodule

